{
  "name": "desktop-widgets",
  "productName": "Desktop Widgets",
  "version": "1.0.0",
  "description": "Free, unlimited macOS-style desktop widgets for macOS and Windows. Positions are saved and widgets return after restart.",
  "main": "src/main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.desktopwidgets",
    "productName": "Desktop Widgets",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "mac": { "category": "public.app-category.utilities", "minimumSystemVersion": "11.0", "target": ["dmg", "zip"], "icon": "build/icon.png" },
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
